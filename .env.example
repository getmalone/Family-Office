# Family Office Configuration
# Copy to .env and fill in values

# Database encryption passphrase (REQUIRED)
KFO_DB_PASSPHRASE=change-me-to-a-strong-passphrase

# Database file path
KFO_DB_PATH=data/family_office.db

# LLM Configuration
KFO_LLM_PROVIDER=anthropic
KFO_LLM_MODEL=claude-sonnet-4-20250514
KFO_ANTHROPIC_API_KEY=sk-ant-...
# KFO_OPENAI_API_KEY=sk-...

# Approval thresholds
KFO_TRADE_APPROVAL_THRESHOLD=50000
KFO_GIFT_APPROVAL_THRESHOLD=18000

# Server
# Use 127.0.0.1 for local-only. Set 0.0.0.0 to make the app reachable from
# other devices on your network (phone/tablet/laptop) — but set KFO_ACCESS_CODE
# below first. The helper script scripts/serve.sh binds 0.0.0.0 for you.
KFO_HOST=127.0.0.1
KFO_PORT=8000

# Web access control (optional).
# Leave empty for the open, local-first single-user experience on 127.0.0.1.
# Set a shared passphrase before exposing the app on a network or the internet:
# every request will then require signing in at /login.
KFO_ACCESS_CODE=
# Days a login session stays valid.
KFO_SESSION_MAX_AGE_DAYS=30

# Market data cache TTL (minutes)
KFO_MARKET_DATA_CACHE_TTL_MINUTES=15
