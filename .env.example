# Family Office Configuration
# Copy to .env and fill in values

# Database encryption passphrase (REQUIRED)
KFO_DB_PASSPHRASE=change-me-to-a-strong-passphrase

# Database file path
KFO_DB_PATH=data/family_office.db

# LLM Configuration
KFO_LLM_PROVIDER=anthropic
KFO_LLM_MODEL=claude-sonnet-4-20250514
KFO_ANTHROPIC_API_KEY=sk-ant-...
# KFO_OPENAI_API_KEY=sk-...

# Approval thresholds
KFO_TRADE_APPROVAL_THRESHOLD=50000
KFO_GIFT_APPROVAL_THRESHOLD=18000

# Server
KFO_HOST=127.0.0.1
KFO_PORT=8000

# Market data cache TTL (minutes)
KFO_MARKET_DATA_CACHE_TTL_MINUTES=15
